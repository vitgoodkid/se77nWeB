# Copy to .env.local for local dev. NEVER commit .env.local.
# In production, set these in Vercel dashboard → Settings → Environment Variables.

# yunwu.api — Gemini chat (OpenAI-compatible)
YUNWU_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YUNWU_BASE_URL=https://yunwu.ai/v1
YUNWU_CHAT_MODEL=gemini-3.1-flash-lite

# fal.ai — image + video gen
FAL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FAL_IMAGE_MODEL=fal-ai/openai/gpt-image-2/edit
# Store AI product views default to nano; on content-checker, auto-fallback to Grok.
FAL_IMAGE_NANO_MODEL=fal-ai/nano-banana-pro/edit
FAL_IMAGE_GROK_MODEL=xai/grok-imagine-image/edit
FAL_IMAGE_GROK_T2I_MODEL=xai/grok-imagine-image
FAL_VIDEO_T2V_MODEL=fal-ai/bytedance/seedance-2.0/text-to-video
FAL_VIDEO_I2V_MODEL=fal-ai/bytedance/seedance-2.0/image-to-video
FAL_BG_REMOVE_MODEL=fal-ai/ideogram/remove-background

# ─── Auth + database (optional — only needed for login + user-data sync) ───
# MongoDB Atlas connection string. Free M0 cluster is enough.
# Format: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Random ≥24 chars. Used to sign session JWT cookies and OAuth state.
# Generate: `openssl rand -base64 48` or `node -e "console.log(crypto.randomBytes(48).toString('base64'))"`
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-24-chars

# Public base URL of the site, used to build OAuth redirect URIs.
# Production: https://your-domain.com (no trailing slash)
# Local with `vercel dev`: http://localhost:3000
# Leave blank to auto-detect from request headers (works in most cases).
AUTH_BASE_URL=https://your-domain.com

# Discord OAuth — https://discord.com/developers/applications
# Add redirect URI: <AUTH_BASE_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional exact override if Discord Developer Portal uses a custom callback URL.
# Must match one of the OAuth2 Redirects exactly.
DISCORD_REDIRECT_URI=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Add redirect URI: <AUTH_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ─── Google Drive — Toolbox → Game Resources ─────────────────────
# API key from Google Cloud Console (Drive API enabled, no OAuth needed).
# Folder must be shared "Anyone with the link → Viewer".
GDRIVE_API_KEY=AIzaSy...
GDRIVE_FOLDER_ID=1abcXYZ...

# ─── Converter — link → audio (YouTube / TikTok / …) ───────────
# Optional. Self-hosted Cobalt instance used by Toolbox → Converter → VIDEO
# when the user pastes a platform page link. Direct .mp4/.webm/audio URLs
# work without this (browser fetch + ffmpeg.wasm).
# Docs: https://github.com/imputnet/cobalt
# COBALT_API_URL=https://cobalt.example.com
# COBALT_API_KEY=

# ─── Tech Stack Monitor ─────────────────────────────────────────
# Email of the user whose subscription stack is shown to anonymous visitors.
# Must match the `email` stored on that user's account (set during OAuth login).
PUBLIC_TECH_OWNER_EMAIL=you@example.com

# ─── Private AI History Feed ────────────────────────────────────
# Comma- or whitespace-separated email allowlist. Only these signed-in users
# can read/post to /api/toolbox?kind=history. PUBLIC_TECH_OWNER_EMAIL acts as
# admin (can delete any item). Leave blank to fully disable the feed.
FEED_WHITELIST_EMAILS=you@example.com,friend@example.com

# --- KataShop ---------------------------------------------------------------
# AI product fill (admin editor → "AI điền từ ảnh") uses OpenRouter vision.
# Same key powers /api/chat image analysis.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Prefer Pro for store listing quality (vision + reasoning).
OPENROUTER_VISION_MODEL=google/gemini-2.5-pro
STORE_AI_MODEL=google/gemini-2.5-pro
# Discord webhook that receives new order notifications. Orders are still
# stored in MongoDB when this is empty.
STORE_DISCORD_WEBHOOK_URL=
# Optional Store-specific owner rules. Falls back to OWNER_DISCORD_ID(S),
# OWNER_EMAILS and PUBLIC_TECH_OWNER_EMAIL. Discord IDs may be comma-separated.
STORE_OWNER_DISCORD_ID=397342895327150080,609407967586156544,489092502998220812
STORE_OWNER_EMAILS=you@example.com
STORE_SUPPORT_LABEL=Message support
STORE_R2_ACCOUNT_ID=
STORE_R2_ACCESS_KEY_ID=
STORE_R2_SECRET_ACCESS_KEY=
STORE_R2_BUCKET=katas-media
STORE_R2_PUBLIC_URL=
