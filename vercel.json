{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/store", "destination": "/index.html" },
    { "source": "/store/:path*", "destination": "/index.html" },
    { "source": "/api/auth/google/start", "destination": "/api/auth/google-start" },
    { "source": "/api/auth/google/callback", "destination": "/api/auth/google-callback" },
    { "source": "/api/auth/discord/start", "destination": "/api/auth/discord-start" },
    { "source": "/api/auth/discord/callback", "destination": "/api/auth/discord-callback" },
    { "source": "/api/kata/:path*", "destination": "/api/auth/__kata__?kataPath=:path*" },
    { "source": "/s/:slug", "destination": "/api/toolbox?kind=short&slug=:slug&go=1" },
    { "source": "/p/:id", "destination": "/api/toolbox?kind=paste&id=:id&view=1" },
    { "source": "/thao/iuuuu", "destination": "/thao/index.html" },
    { "source": "/thao/iuuuu/", "destination": "/thao/index.html" },
    { "source": "/kata", "destination": "/kata/index.html" },
    { "source": "/kata/", "destination": "/kata/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
